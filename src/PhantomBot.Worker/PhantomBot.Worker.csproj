<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PhantomBot.Core/PhantomBot.Core.csproj" />
    <ProjectReference Include="../PhantomBot.Infrastructure/PhantomBot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.28" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-beta.28" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.28" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhantomBot.Worker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
